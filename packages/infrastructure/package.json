{
  "name": "@loadbearing/infrastructure",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist",
    "smoke": "tsx src/smoke/index.ts"
  },
  "devDependencies": {
    "@loadbearing/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "dotenv": "catalog:",
    "rimraf": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@loadbearing/application": "workspace:*",
    "@loadbearing/core": "workspace:*",
    "@loadbearing/errors": "workspace:*",
    "bullmq": "catalog:",
    "ioredis": "catalog:"
  }
}
